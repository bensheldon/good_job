    # @raises [TypeError] If the bundle is not a string.
    #
    # pkg:gem/io-endpoint#lib/io/endpoint/tls/certificates.rb:20
    def parse(certificate_bundle); end
  end
end

# Matches individual certificates in a PEM bundle.
#
# pkg:gem/io-endpoint#lib/io/endpoint/tls/certificates.rb:12
IO::Endpoint::TLS::Certificates::CERTIFICATE_PATTERN = T.let(T.unsafe(nil), Regexp)

# Represents transport-neutral TLS certificate and verification configuration.
#
# pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:12
class IO::Endpoint::TLS::Configuration
  # Initialize a TLS configuration from PEM-encoded certificate and private key material.
  # @parameter trust_store [TrustStore | Nil] The trusted certificate sources.
  # @parameter certificate_chain [Array(String) | Nil] The ordered local certificate chain encoded as individual PEM strings, with the leaf certificate followed by any intermediates.
  # @parameter private_key [String | Nil] The private key encoded as PEM.
  # @parameter verification [Symbol | Nil] The peer verification policy: `:none`, `:peer`, or `:required`. When omitted, `:peer` is used if a trust store is provided.
  # @raises [ArgumentError] If the certificate chain and private key are not provided together, or the verification policy is invalid.
  # @raises [TypeError] If the certificate chain or private key uses an unsupported representation.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:20
  def initialize(trust_store: T.unsafe(nil), certificate_chain: T.unsafe(nil), private_key: T.unsafe(nil), verification: T.unsafe(nil)); end

  # Compare configurations by their certificate material and verification policy.
  # @parameter other [Object] The object to compare.
  # @returns [Boolean] Whether both configurations have the same class and values.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:65
  def ==(other); end

  # @attribute [Array(String) | Nil] The ordered local certificate chain encoded as individual PEM strings, with the leaf certificate followed by any intermediates.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:54
  def certificate_chain; end

  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:73
  def eql?(other); end

  # Freeze the configuration and independent copies of its certificate material, without freezing caller-owned values.
  # @returns [Configuration] This immutable configuration. Use `dup.freeze` to preserve the original configuration too.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:83
  def freeze; end

  # Compute a hash from the configuration values. Freeze the configuration before using it as a hash key.
  # @returns [Integer] The hash of the configuration.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:77
  def hash; end

  # Get a representation of the configuration without exposing certificate or private key material.
  # @returns [String] A redacted representation of the configuration.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:101
  def inspect; end

  # @attribute [String | Nil] The private key encoded as PEM.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:57
  def private_key; end

  # @attribute [TrustStore | Nil] The trusted certificate sources.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:51
  def trust_store; end

  # @attribute [Symbol | Nil] The peer verification policy.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:60
  def verification; end

  # Whether peer certificates should be verified.
  # @returns [Boolean] Whether peer verification is enabled.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/tls/configuration.rb:95
  def verify_peer?; end
end

# Provides OpenSSL compilation for transport-neutral TLS configuration.
#
# pkg:gem/io-endpoint#lib/io/endpoint/tls/openssl.rb:14
module IO::Endpoint::TLS::OpenSSL
  class << self
    # Apply transport-neutral TLS configuration to an OpenSSL context.
    # @parameter context [OpenSSL::SSL::SSLContext] The OpenSSL context to configure.
    # @parameter configuration [Configuration] The transport-neutral TLS configuration.
    # @parameter hostname [String | Nil] The hostname to verify for client connections.
    # @returns [OpenSSL::SSL::SSLContext] The configured OpenSSL context.
    #
    # pkg:gem/io-endpoint#lib/io/endpoint/tls/openssl.rb:33
    def apply(context, configuration, hostname: T.unsafe(nil)); end

    # Build an OpenSSL certificate store from transport-neutral trusted certificate configuration.
