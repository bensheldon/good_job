  def to_s; end
end

# This class doesn't exert ownership over the specified socket, wraps a native ::IO.
#
# pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:10
class IO::Endpoint::SocketEndpoint < ::IO::Endpoint::Generic
  # Initialize a new socket endpoint.
  # @parameter socket [Socket] The socket to wrap.
  # @parameter options [Hash] Additional options to pass to the parent class.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:14
  def initialize(socket, **options); end

  # Bind using the wrapped socket.
  # @yields {|socket| ...} If a block is given, yields the socket.
  # 	@parameter socket [Socket] The socket.
  # @returns [Socket] The socket.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:39
  def bind(&block); end

  # Connect using the wrapped socket.
  # @yields {|socket| ...} If a block is given, yields the socket.
  # 	@parameter socket [Socket] The socket.
  # @returns [Socket] The socket.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:51
  def connect(&block); end

  # Get a detailed string representation of the socket endpoint.
  # @returns [String] A detailed string representation including the socket.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:28
  def inspect; end

  # @attribute [Socket] The wrapped socket.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:33
  def socket; end

  # Get a string representation of the socket endpoint.
  # @returns [String] A string representation showing the socket.
  #
  # pkg:gem/io-endpoint#lib/io/endpoint/socket_endpoint.rb:22
  def to_s; end
end

# @namespace
