# Sub-class thread so we have a named thread (useful for debugging in Thread.list).
#
# pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:10
class Rack::MiniProfiler::MemoryStore::CacheCleanupThread < ::Thread
  # pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:12
  def initialize(interval, cycle, store); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:34
  def cleanup; end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:39
  def cycle_count; end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:43
  def increment_cycle; end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:20
  def should_cleanup?; end

  # We don't want to hit the filesystem every 10s to clean up the cache so we need to do a bit of
  # accounting to avoid sleeping that entire time.  We don't want to sleep for the entire period because
  # it means the thread will stay live in hot deployment scenarios, keeping a potentially large memory
  # graph from being garbage collected upon undeploy.
  #
  # pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:28
  def sleepy_run; end
end

# pkg:gem/rack-mini-profiler#lib/mini_profiler/storage/memory_store.rb:48
Rack::MiniProfiler::MemoryStore::EXPIRES_IN_SECONDS = T.let(T.unsafe(nil), Integer)

# pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:5
module Rack::MiniProfiler::ProfilingMethods
  # Add a custom timing. These are displayed similar to SQL/query time in
  # columns expanding to the right.
  #
  # type        - String counter type. Each distinct type gets its own column.
  # duration_ms - Duration of the call in ms. Either this or a block must be
  #               given but not both.
  #
  # When a block is given, calculate the duration by yielding to the block
  # and keeping a record of its run time.
  #
  # Returns the result of the block, or nil when no block is given.
  #
  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:148
  def counter(type, duration_ms = T.unsafe(nil)); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:69
  def counter_method(klass, method, &blk); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:32
  def finish_step(obj); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:77
  def profile_method(klass, method, type = T.unsafe(nil), &blk); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:129
  def profile_singleton_method(klass, method, type = T.unsafe(nil), &blk); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:7
  def record_sql(query, elapsed_ms, params = T.unsafe(nil), cached = T.unsafe(nil)); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:21
  def report_reader_duration(elapsed_ms, row_count = T.unsafe(nil), class_name = T.unsafe(nil)); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:25
  def start_step(name); end

  # perform a profiling step on given block
  #
  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:40
  def step(name, opts = T.unsafe(nil)); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:73
  def uncounter_method(klass, method); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:55
  def unprofile_method(klass, method); end

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:133
  def unprofile_singleton_method(klass, method); end

  private

  # pkg:gem/rack-mini-profiler#lib/mini_profiler/profiling_methods.rb:162
  def clean_method_name(method); end
end

