# Writes body data to an HTTP/2 stream, respecting flow control windows.
#
# pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:13
class Async::HTTP::Protocol::HTTP2::Output
  # Initialize the output handler.
  # @parameter stream [Stream] The HTTP/2 stream to write to.
  # @parameter body [Protocol::HTTP::Body::Readable] The body to read from.
  # @parameter trailer [Protocol::HTTP::Headers | Nil] Optional trailing headers.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:18
  def initialize(stream, body, trailer = T.unsafe(nil)); end

  # This method should only be called from within the context of the output task.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:88
  def close(error = T.unsafe(nil)); end

  # Close the wire output without cancelling a streamable body. This allows bidirectional bodies to observe an orderly input closure and finish normally. A non-streaming producer has no input side through which closure can propagate, so it is stopped directly.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:102
  def close_stream; end

  # Finish writing to the stream.
  # @parameter error [Exception | Nil] An optional error that caused the close.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:80
  def close_write(error = T.unsafe(nil)); end

  # Start an asynchronous task to write the body to the stream.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:32
  def start(parent: T.unsafe(nil)); end

  # This method should only be called from within the context of the HTTP/2 stream.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:94
  def stop(error); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:29
  def trailer; end

  # Signal that the flow control window has been updated.
  # @parameter size [Integer] The new window size.
  # @returns [Boolean] Always returns `true`.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:45
  def window_updated(size); end

  # Write a chunk of data to the HTTP/2 stream, respecting flow control.
  # @parameter chunk [String] The data to write.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:55
  def write(chunk); end

  private

  # Reads chunks from the given body and writes them to the stream as fast as possible.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:129
  def passthrough(task); end

  # Send `maximum_size` bytes of data using the specified `stream`. If the buffer has no more chunks, `END_STREAM` will be sent on the final chunk.
  # @param maximum_size [Integer] send up to this many bytes of data.
  # @param stream [Stream] the stream to use for sending data frames.
  # @return [String, nil] any data that could not be written.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:155
  def send_data(stream, chunk, maximum_size); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/output.rb:116
  def stream(task); end
end

