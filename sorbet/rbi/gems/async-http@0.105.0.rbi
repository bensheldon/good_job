# Provides shared connection behaviour for HTTP/2 client and server connections.
#
# pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:31
module Async::HTTP::Protocol::HTTP2::Connection
  # Initialize the connection state.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:33
  def initialize(*, **, &); end

  # @returns [String] A JSON-compatible representation.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:64
  def as_json(*, **, &); end

  # Close the connection and stop the background reader.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:91
  def close(error = T.unsafe(nil)); end

  # The connection has finished draining the streams which the remote peer accepted before its graceful GOAWAY.
  #
  # The last of those streams can complete on the sending side, in a task other than the background reader - the response arrived first and the request body was still being written. The reader is then parked in a blocking read and will never notice that the connection is closed, so we stop it and let its `ensure` close the connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:105
  def close_if_drained!; end

  # @returns [Integer] The maximum number of concurrent streams allowed.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:151
  def concurrency; end

  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:148
  def count; end

  # @returns [Boolean] Whether this is an HTTP/1 connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:76
  def http1?; end

  # @returns [Boolean] Whether this is an HTTP/2 connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:81
  def http2?; end

  # @returns [Protocol::HTTP::Peer] The peer information for this connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:144
  def peer; end

  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:141
  def promises; end

  # Start a transient background task that reads frames from the connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:114
  def read_in_background(parent: T.unsafe(nil)); end

  # @returns [Boolean] Whether the connection can be reused.
  #
  # Once the remote peer has sent a GOAWAY frame, it will not process any new streams on this connection, so it must not be handed out for another request, even while the streams it accepted are still being drained.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:163
  def reusable?; end

  # Start the background reader task if it is not already running.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:86
  def start_connection; end

  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:73
  def stream; end

  # Synchronize write access to the connection.
  # @yields {|...| ...} The block to execute while holding the write lock.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:44
  def synchronize(&block); end

  # @returns [String] A JSON string representation.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:69
  def to_json(*, **, &); end

  # @returns [String] A string representation of this connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:59
  def to_s; end

  # @returns [String] The HTTP version string.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:168
  def version; end

  # Can we use this connection to make requests?
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:156
  def viable?; end

  # Write a single frame, deferring stop until the frame is written.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:49
  def write_frame(frame); end

  # Write multiple frames, deferring stop until the frames are written.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:54
  def write_frames; end
end

