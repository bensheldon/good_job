  # Assign the connection pool, releasing the connection when the stream is closed.
  # @parameter pool [Async::Pool::Controller] The connection pool.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:153
  def pool=(pool); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:149
  def request; end

  # Send a request and read it into this response.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:230
  def send_request(request); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:148
  def stream; end

  # @returns [Boolean] Whether the response has a valid status.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:190
  def valid?; end

  # Wait for the response headers to be received.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:169
  def wait; end
end

# Represents the HTTP/2 stream associated with an outgoing client-side response.
#
# pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:18
class Async::HTTP::Protocol::HTTP2::Response::Stream < ::Async::HTTP::Protocol::HTTP2::Stream
  # Initialize the response stream.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:20
  def initialize(*); end

  # Handle a push promise stream from the server.
  # @parameter promised_stream_id [Integer] The stream ID for the promised resource.
  # @parameter headers [Array] The promise headers.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:45
  def accept_push_promise_stream(promised_stream_id, headers); end

  # Called when the stream is closed.
  # @parameter error [Exception | Nil] The error that caused the close, if any.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:125
  def closed(error); end

  # This should be invoked from the background reader, and notifies the task waiting for the headers that we are done.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:50
  def receive_initial_headers(headers, end_stream); end

  # Process interim (1xx) response headers.
  # @parameter status [Integer] The interim status code.
  # @parameter headers [Array] The interim response headers.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:102
  def receive_interim_headers(status, headers); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:28
  def response; end

  # Wait for the headers to be received or for stream reset.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:113
  def wait; end

  # Wait for the response headers and return the response body.
  # @returns [Protocol::HTTP::Body::Readable | Nil] The response body.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/response.rb:32
  def wait_for_input; end
end

# pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:19
Async::HTTP::Protocol::HTTP2::SCHEME = T.let(T.unsafe(nil), String)

# The default settings for the server.
#
# pkg:gem/async-http#lib/async/http/protocol/http2.rb:42
Async::HTTP::Protocol::HTTP2::SERVER_SETTINGS = T.let(T.unsafe(nil), Hash)

# pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:23
Async::HTTP::Protocol::HTTP2::STATUS = T.let(T.unsafe(nil), String)

# An HTTP/2 server connection that receives requests and sends responses.
#
# pkg:gem/async-http#lib/async/http/protocol/http2/server.rb:17
class Async::HTTP::Protocol::HTTP2::Server < ::Protocol::HTTP2::Server
  include ::Async::HTTP::Protocol::HTTP2::Connection

  # Initialize the HTTP/2 server with an IO stream.
  # @parameter stream [IO::Stream] The underlying stream.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/server.rb:22
  def initialize(stream); end

  # Accept a new stream from a client.
  # @parameter stream_id [Integer] The stream ID assigned by the client.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/server.rb:37
  def accept_stream(stream_id); end

  # Close the server connection and stop accepting requests.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/server.rb:44
  def close(error = T.unsafe(nil)); end

  # Enumerate incoming requests, yielding each one for processing.
  # @yields {|request| ...} Each incoming request.
  # 	@parameter request [Request] The incoming HTTP/2 request.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/server.rb:53
  def each(task: T.unsafe(nil)); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/server.rb:33
  def requests; end
end

# An HTTP/2 stream that manages headers, input data, and output data for a single request/response exchange.
#
# pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:18
class Async::HTTP::Protocol::HTTP2::Stream < ::Protocol::HTTP2::Stream
  # Initialize the stream state.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:20
  def initialize(*); end

  # Add a header to the stream, validating against HTTP/2 constraints.
  # @parameter key [String] The header name.
  # @parameter value [String] The header value.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:47
  def add_header(key, value, trailer: T.unsafe(nil)); end

  # When the stream transitions to the closed state, this method is called. There are roughly two ways this can happen:
  # - A frame is received which causes this stream to enter the closed state. This method will be invoked from the background reader task.
  # - A frame is sent which causes this stream to enter the closed state. This method will be invoked from that task.
  # While the input stream is relatively straight forward, the output stream can trigger the second case above
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:212
  def closed(error); end

  # Close the application-facing receiving side of the stream. While local output remains active, incoming data is discarded with flow-control updates. Once local output is also closed, the remaining wire stream is terminated without an error.
  # @parameter input [Input] The input body being closed.
  # @parameter error [Exception | Nil] The error which closed the input.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:143
  def finish_input(input, error = T.unsafe(nil)); end

  # Called when the output terminates normally.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:164
  def finish_output(error = T.unsafe(nil)); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:38
  def headers; end

  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:38
  def headers=(_arg0); end

  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:42
  def input; end

  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:40
  def pool; end

  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:40
  def pool=(_arg0); end

  # Prepare the input stream which will be used for incoming data frames.
  # @return [Input] the input body.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:97
  def prepare_input(length); end

  # Process an incoming DATA frame and write it to the input body.
  # @parameter frame [Protocol::HTTP2::DataFrame] The data frame to process.
  # @returns [String] The unpacked data.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:117
  def process_data(frame); end

  # Process an incoming HEADERS frame, dispatching to initial or trailing header handling.
  # @parameter frame [Protocol::HTTP2::HeadersFrame] The headers frame to process.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:70
  def process_headers(frame); end

  # Process trailing headers received after the body.
  # @parameter headers [Array] The trailing header key-value pairs.
  # @parameter end_stream [Boolean] Whether the stream ends after these headers.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:62
  def receive_trailing_headers(headers, end_stream); end

  # Set the body and begin sending it.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:157
  def send_body(body, trailer = T.unsafe(nil)); end

  # Send data and apply any pending application-side closure.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:202
  def send_data(*, **, &); end

  # Send headers and apply any pending application-side closure.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:195
  def send_headers(*, **, &); end

  # Update the local flow control window after receiving data.
  # @parameter frame [Protocol::HTTP2::DataFrame] The received data frame.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:107
  def update_local_window(frame); end

  # @returns [Input | Nil] The input body for this stream, if available.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:91
  def wait_for_input; end

  # Called when the flow control window is updated.
  # @parameter size [Integer] The new window size.
  # @returns [Boolean] Always returns `true`.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:186
  def window_updated(size); end

  private

  # If both application-facing directions are closed but the peer has not finished, terminate the remaining wire stream without an error.
  #
  # pkg:gem/async-http#lib/async/http/protocol/http2/stream.rb:244
  def close_if_finished; end
end

# pkg:gem/async-http#lib/async/http/protocol/http2/connection.rb:28
Async::HTTP::Protocol::HTTP2::TRAILER = T.let(T.unsafe(nil), String)

# pkg:gem/async-http#lib/async/http/protocol/http2.rb:21
Async::HTTP::Protocol::HTTP2::VERSION = T.let(T.unsafe(nil), String)

# pkg:gem/async-http#lib/async/http/protocol/http.rb:17
Async::HTTP::Protocol::HTTP::HTTP2_PREFACE = T.let(T.unsafe(nil), String)

# pkg:gem/async-http#lib/async/http/protocol/http.rb:18
Async::HTTP::Protocol::HTTP::HTTP2_PREFACE_SIZE = T.let(T.unsafe(nil), Integer)

# A server that supports both HTTP1.0 and HTTP1.1 semantics by detecting the version of the request.
#
# pkg:gem/async-http#lib/async/http/protocol/https.rb:17
class Async::HTTP::Protocol::HTTPS
  extend ::Async::HTTP::Protocol::Defaulton

  # Initialize the HTTPS protocol negotiator.
  # @parameter handlers [Hash] A mapping of ALPN protocol names to protocol classes.
  # @parameter options [Hash] Per-protocol options keyed by protocol class.
  #
  # pkg:gem/async-http#lib/async/http/protocol/https.rb:29
  def initialize(handlers = T.unsafe(nil), **options); end

  # Register a protocol handler for a given ALPN protocol name.
  # @parameter name [String] The ALPN protocol name.
  # @parameter protocol [Class] The protocol class to handle connections.
  # @parameter options [Hash] Options to pass when creating client or server instances.
  #
  # pkg:gem/async-http#lib/async/http/protocol/https.rb:38
  def add(name, protocol, **options); end

  # Create a client for an outbound connection.
  #
  # @parameter peer [IO] The peer to communicate with.
  # @parameter options [Hash] Options to pass to the client instance.
  #
  # pkg:gem/async-http#lib/async/http/protocol/https.rb:66
  def client(peer, **options); end

  # @returns [Array] The names of the supported protocol, used for Application Layer Protocol Negotiation (ALPN).
  #
  # pkg:gem/async-http#lib/async/http/protocol/https.rb:85
  def names; end

  # Determine the protocol of the peer and return the appropriate protocol class.
  #
  # Use TLS Application Layer Protocol Negotiation (ALPN) to determine the protocol.
  #
  # @parameter peer [IO] The peer to communicate with.
  # @returns [Class] The protocol class to use.
  #
  # pkg:gem/async-http#lib/async/http/protocol/https.rb:49
  def protocol_for(peer); end

  # Create a server for an inbound connection.
  #
  # @parameter peer [IO] The peer to communicate with.
  # @parameter options [Hash] Options to pass to the server instance.
  #
  # pkg:gem/async-http#lib/async/http/protocol/https.rb:77
  def server(peer, **options); end
end

# The protocol classes for each supported protocol.
#
# pkg:gem/async-http#lib/async/http/protocol/https.rb:19
Async::HTTP::Protocol::HTTPS::HANDLERS = T.let(T.unsafe(nil), Hash)

# An incoming HTTP request generated by server protocol implementations.
#
# pkg:gem/async-http#lib/async/http/protocol/request.rb:15
class Async::HTTP::Protocol::Request < ::Protocol::HTTP::Request
  # @returns [Connection | Nil] The underlying protocol connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/request.rb:17
  def connection; end

  # @returns [Boolean] Whether this request supports connection hijacking.
  #
  # pkg:gem/async-http#lib/async/http/protocol/request.rb:22
  def hijack?; end

  # @returns [String] A string representation of the request.
  #
  # pkg:gem/async-http#lib/async/http/protocol/request.rb:43
  def inspect; end

  # @returns [Protocol::HTTP::Peer | Nil] The peer associated with this connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/request.rb:33
  def peer; end

  # @returns [Addrinfo | Nil] The remote address of the peer.
  #
  # pkg:gem/async-http#lib/async/http/protocol/request.rb:38
  def remote_address; end

  # Write an interim (1xx) response back to the client.
  # @parameter status [Integer] The interim HTTP status code.
  # @parameter headers [Hash | Nil] Optional headers to include.
  #
  # pkg:gem/async-http#lib/async/http/protocol/request.rb:29
  def write_interim_response(status, headers = T.unsafe(nil)); end
end

# An HTTP response received from a server via client protocol implementations.
#
# pkg:gem/async-http#lib/async/http/protocol/response.rb:14
class Async::HTTP::Protocol::Response < ::Protocol::HTTP::Response
  # @returns [Connection | Nil] The underlying protocol connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/response.rb:16
  def connection; end

  # @returns [Boolean] Whether this response supports connection hijacking.
  #
  # pkg:gem/async-http#lib/async/http/protocol/response.rb:21
  def hijack?; end

  # @returns [String] A string representation of the response.
  #
  # pkg:gem/async-http#lib/async/http/protocol/response.rb:36
  def inspect; end

  # @returns [Protocol::HTTP::Peer | Nil] The peer associated with this connection.
  #
  # pkg:gem/async-http#lib/async/http/protocol/response.rb:26
  def peer; end

  # @returns [Addrinfo | Nil] The remote address of the peer.
  #
  # pkg:gem/async-http#lib/async/http/protocol/response.rb:31
  def remote_address; end
end

# Wraps a client, address and headers required to initiate a connectio to a remote host using the CONNECT verb.
# Behaves like a TCP endpoint for the purposes of connecting to a remote host.
#
# pkg:gem/async-http#lib/async/http/proxy.rb:15
class Async::HTTP::Proxy
  # @param client [Async::HTTP::Client] the client which will be used as a proxy server.
  # @param address [String] the address to connect to.
  # @param headers [Array] an optional list of headers to use when establishing the connection.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:79
  def initialize(client, address, headers = T.unsafe(nil)); end

  # pkg:gem/async-http#lib/async/http/proxy.rb:85
  def client; end

  # Close the underlying client connection.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:88
  def close; end

  # Establish a TCP connection to the specified host.
  # @return [Socket] a connected bi-directional socket.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:94
  def connect(&block); end

  # @return [Async::HTTP::Endpoint] an endpoint that connects via the specified proxy.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:119
  def wrap_endpoint(endpoint); end

  class << self
    # Construct a endpoint that will use the given client as a proxy for HTTP requests.
    # @param client [Async::HTTP::Client] the client which will be used as a proxy server.
    # @param endpoint [Async::HTTP::Endpoint] the endpoint to connect to.
    # @param headers [Array] an optional list of headers to use when establishing the connection.
    #
    # pkg:gem/async-http#lib/async/http/proxy.rb:70
    def endpoint(client, endpoint, headers = T.unsafe(nil)); end

    # Prepare and endpoint which can establish a TCP connection to the remote system.
    # @param client [Async::HTTP::Client] the client which will be used as a proxy server.
    # @param host [String] the hostname or address to connect to.
    # @param port [String] the port number to connect to.
    # @param headers [Array] an optional list of headers to use when establishing the connection.
    # @see IO::Endpoint#tcp
    #
    # pkg:gem/async-http#lib/async/http/proxy.rb:62
    def tcp(client, host, port, headers = T.unsafe(nil)); end
  end
end

# Extends {Async::HTTP::Client} with proxy capabilities.
#
# pkg:gem/async-http#lib/async/http/proxy.rb:29
module Async::HTTP::Proxy::Client
  # Create a client that will proxy requests through the current client.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:39
  def proxied_client(endpoint, headers = T.unsafe(nil)); end

  # Create an endpoint that connects via this proxy.
  # @parameter endpoint [Endpoint] The target endpoint.
  # @parameter headers [Hash | Nil] Optional headers for the CONNECT request.
  # @returns [Endpoint] An endpoint that tunnels through the proxy.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:49
  def proxied_endpoint(endpoint, headers = T.unsafe(nil)); end

  # Create a proxy instance for the given endpoint.
  # @parameter endpoint [Endpoint] The target endpoint to tunnel to.
  # @parameter headers [Hash | Nil] Optional headers to send with the CONNECT request.
  # @returns [Proxy] A proxy instance for establishing tunnels.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:34
  def proxy(endpoint, headers = T.unsafe(nil)); end
end

# Raised when a CONNECT tunnel through a proxy cannot be established.
#
# pkg:gem/async-http#lib/async/http/proxy.rb:17
class Async::HTTP::Proxy::ConnectFailure < ::StandardError
  # Initialize the failure with the unsuccessful response.
  # @parameter response [Protocol::HTTP::Response] The failed response from the proxy.
  #
  # pkg:gem/async-http#lib/async/http/proxy.rb:20
  def initialize(response); end

  # pkg:gem/async-http#lib/async/http/proxy.rb:25
  def response; end
end

# pkg:gem/async-http#lib/async/http/body/writable.rb:12
class Protocol::HTTP::Body::Writable < ::Protocol::HTTP::Body::Readable; end
