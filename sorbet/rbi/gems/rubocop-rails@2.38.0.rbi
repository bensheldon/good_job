#   class User < ApplicationRecord
#     attribute :confirmed_at, :datetime, default: -> { Time.zone.now }
#   end
#
#   # bad
#   class User < ApplicationRecord
#     attribute :roles, :string, array: true, default: []
#   end
#
#   # good
#   class User < ApplicationRecord
#     attribute :roles, :string, array: true, default: -> { [] }
#   end
