# This module allows cops to detect and ignore files that have already been migrated
# by leveraging the `AllCops: MigratedSchemaVersion` configuration.
#
# [source,yaml]
# -----
# AllCops:
#   MigratedSchemaVersion: '20241225000000'
# -----
#
# When applied to cops, it overrides the `add_global_offense` and `add_offense` methods,
# ensuring that cops skip processing if the file is determined to be a migrated file
# based on the schema version.
#
# @api private
#
# pkg:gem/rubocop-rails#lib/rubocop/rails/migration_file_skippable.rb:19
module RuboCop::Rails::MigrationFileSkippable
  # pkg:gem/rubocop-rails#lib/rubocop/rails/migration_file_skippable.rb:20
  def add_global_offense(message = T.unsafe(nil), severity: T.unsafe(nil)); end

  # pkg:gem/rubocop-rails#lib/rubocop/rails/migration_file_skippable.rb:26
  def add_offense(node_or_range, message: T.unsafe(nil), severity: T.unsafe(nil), &block); end

  private

  # pkg:gem/rubocop-rails#lib/rubocop/rails/migration_file_skippable.rb:34
  def already_migrated_file?; end

  # pkg:gem/rubocop-rails#lib/rubocop/rails/migration_file_skippable.rb:45
  def migrated_schema_version; end
end

