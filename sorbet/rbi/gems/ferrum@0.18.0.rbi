  #
  # pkg:gem/ferrum#lib/ferrum/client.rb:307
  def inspect; end

  # Unsubscribes from a CDP event.
  #
  # @param [String] event
  #   The CDP event name.
  #
  # @param [Integer] id
  #   The subscription id returned by {#on}.
  #
