  # Debug representation of the worker.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/worker.rb:83
  def inspect; end

  # Workers have a single execution context and no navigable document, so
  # there's nothing for {Network} to check requests against.
  #
  # pkg:gem/ferrum#lib/ferrum/worker.rb:56
  def main_frame; end

  # Network object.
  #
  # @return [Network]
  #
  # pkg:gem/ferrum#lib/ferrum/worker.rb:37
  def network; end

  # pkg:gem/ferrum#lib/ferrum/worker.rb:19
  def target_id; end

  # How long to wait for CDP responses and JS evaluation to complete.
  #
  # @return [Numeric]
  #
  # pkg:gem/ferrum#lib/ferrum/worker.rb:42
  def timeout; end

  # pkg:gem/ferrum#lib/ferrum/worker.rb:19
  def url; end

  private

  # pkg:gem/ferrum#lib/ferrum/worker.rb:110
  def execution_id!; end

  # pkg:gem/ferrum#lib/ferrum/worker.rb:117
  def execution_id=(value); end

  # pkg:gem/ferrum#lib/ferrum/worker.rb:104
  def prepare; end

  # pkg:gem/ferrum#lib/ferrum/worker.rb:89
