  def mhtml(path: T.unsafe(nil)); end

  # Saves PDF on a disk or returns it as Base64.
  #
  # @param [Hash{Symbol => Object}] opts
  #
  # @option opts [String] :path
  #  The path to save a screenshot on the disk. `:encoding` will be set to
