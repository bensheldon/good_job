  #   page.screenshot(format: "webp", quality: 60) # "iVBORw0KGgoAAAANS...
  #
  # @example Save to Base64 the whole page not only viewport and reduce quality:
  #   page.screenshot(full: true, format: "jpeg", quality: 60) # "iVBORw0KGgoAAAANS...
  #
