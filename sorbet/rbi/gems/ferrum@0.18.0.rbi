# Evaluates and executes JavaScript in a frame's execution context via
# `Runtime.callFunctionOn`, converting arguments and return values
# between Ruby and JS, and resolving object/array/node results
# (including cyclic ones, via {CyclicObject}) into Ruby equivalents.
#
# pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:30
module Ferrum::Frame::Runtime
  # Evaluate and return result for given JS expression.
  #
  # @param [String] expression
  #   The JavaScript to evaluate.
  #
  # @param [Array] args
  #   Additional arguments to pass to the JavaScript code.
  #
  # @example
  #   browser.evaluate("[window.scrollX, window.scrollY]")
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:46
  def evaluate(expression, *args); end

  # Evaluate asynchronous expression and return result.
  #
  # @param [String] expression
  #   The JavaScript to evaluate.
  #
  # @param [Integer] wait
  #   How long we should wait for Promise to resolve or reject.
  #
  # @param [Array] args
  #   Additional arguments to pass to the JavaScript code.
  #
  # @example
  #   browser.evaluate_async(%(arguments[0]({foo: "bar"})), 5) # => { "foo" => "bar" }
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:66
  def evaluate_async(expression, wait, *args); end

  # Evaluates a raw JS function declaration (unlike {#evaluate}, which
  # wraps the given expression in one), optionally on a specific remote
  # object instead of the frame's global execution context.
  #
  # @param [String] expression
  #   A JS function declaration, e.g. `"function(a, b) { return a + b }"`.
  #
  # @param [Array] args
  #   Arguments to pass to the function.
  #
  # @param [Node, nil] on
  #   Remote object to invoke the function on.
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:118
  def evaluate_func(expression, *args, on: T.unsafe(nil)); end

  # Evaluates an expression against a given node's remote object (+this+
  # refers to the node), returning the raw JS value rather than
  # resolving it to a {Node}/Hash/Array.
  #
  # @param [Node] node
  #   The node to evaluate the expression on.
  #
  # @param [String] expression
  #   The JavaScript to evaluate.
  #
  # @param [Boolean] by_value
  #   Whether to return the plain JS value instead of a handle.
  #
  # @param [Integer] wait
  #   Passed through to the underlying `Runtime.callFunctionOn` command.
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:139
  def evaluate_on(node:, expression:, by_value: T.unsafe(nil), wait: T.unsafe(nil)); end

  # Execute expression. Doesn't return the result.
  #
  # @param [String] expression
  #   The JavaScript to evaluate.
  #
  # @param [Array] args
  #   Additional arguments to pass to the JavaScript code.
  #
  # @example
  #   browser.execute(%(1 + 1)) # => true
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:98
  def execute(expression, *args); end

  private

  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:148
  def call(expression:, arguments: T.unsafe(nil), on: T.unsafe(nil), wait: T.unsafe(nil), handle: T.unsafe(nil), **options); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:249
  def cyclic?(object_id); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:282
  def cyclic_object; end

  # FIXME: We should have a central place to handle all type of errors
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:176
  def handle_error(response); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:188
  def handle_response(response); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:223
  def prepare_args(args); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime.rb:236
  def reduce_props(object_id, to); end
end

