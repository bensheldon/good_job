# pkg:gem/ferrum#lib/ferrum/network/request_params.rb:8
module Ferrum::Network::RequestParams
  # pkg:gem/ferrum#lib/ferrum/network/request_params.rb:54
  def body; end

  # The request headers.
  #
  # @return [Hash{String => String}]
  #
  # pkg:gem/ferrum#lib/ferrum/network/request_params.rb:41
  def headers; end

  # The request method.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/request_params.rb:32
  def method; end

  # The optional HTTP `POST` form data.
  #
  # @return [String, nil]
  #   The HTTP `POST` form data.
  #
  # pkg:gem/ferrum#lib/ferrum/network/request_params.rb:51
  def post_data; end

  # The URL for the request.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/request_params.rb:14
  def url; end

  # The URL fragment for the request.
  #
  # @return [String, nil]
  #
  # pkg:gem/ferrum#lib/ferrum/network/request_params.rb:23
  def url_fragment; end
end

# Represents a [Network.Response](https://chromedevtools.github.io/devtools-protocol/1-3/Network/#type-Response)
# object.
#
# pkg:gem/ferrum#lib/ferrum/network/response.rb:9
class Ferrum::Network::Response
  # Initializes the responses object.
  #
  # @param [Page] page
  #   The page associated with the network response.
  #
  # @param [Hash{String => Object}] params
  #   The parsed JSON attributes for the [Network.Response](https://chromedevtools.github.io/devtools-protocol/1-3/Network/#type-Response)
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:35
  def initialize(page, params); end

  # Compares the response's ID to another response's ID.
  #
  # @return [Boolean]
  #   Indicates whether the response has the same ID as the other response
  #   object.
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:178
  def ==(other); end

  # The response body.
  #
  # @return [String, nil]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:142
  def body; end

  # The response body.
  #
  # @return [String]
  #
  # @raise [Ferrum::BrowserError]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:129
  def body!; end

  # The response body size.
  #
  # @return [Integer, nil]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:13
  def body_size; end

  # See https://crbug.com/883475
  # Sometimes we never get the Network.responseReceived event.
  # See https://crbug.com/764946
  # `Network.loadingFinished` encodedDataLength contains both body and
  # headers sizes received by wire.
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:118
  def body_size=(size); end

  # The `Content-Type` header value of the response.
  #
  # @return [String, nil]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:109
  def content_type; end

  # The headers of the response.
  #
  # @return [Hash{String => String}]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:82
  def headers; end

  # The total size in bytes of the response.
  #
  # @return [Integer]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:91
  def headers_size; end

  # The request ID associated with the response.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:46
  def id; end

  # Inspects the response object.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:187
  def inspect; end

  # The response is fully loaded by the browser.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:24
  def loaded=(_arg0); end

  # The response is fully loaded by the browser or not.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:160
  def loaded?; end

  # Whether this response is the main frame's current response.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:153
  def main?; end

  # The parsed JSON attributes for the [Network.Response](https://chromedevtools.github.io/devtools-protocol/1-3/Network/#type-Response)
  # object.
  #
  # @return [Hash{String => Object}]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:19
  def params; end

  # Whether the response is a redirect.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:167
  def redirect?; end

  # The HTTP status of the response.
  #
  # @return [Integer]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:64
  def status; end

  # The HTTP status text.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:73
  def status_text; end

  # pkg:gem/ferrum#lib/ferrum/network/response.rb:191
  def to_h; end

  # The resource type of the response.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:100
  def type; end

  # The URL of the response.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/network/response.rb:55
  def url; end
end

# Raised when there's no JavaScript execution context available to run a
# command against, e.g. because the frame isn't attached.
#
# pkg:gem/ferrum#lib/ferrum/errors.rb:160
class Ferrum::NoExecutionContextError < ::Ferrum::BrowserError
  # pkg:gem/ferrum#lib/ferrum/errors.rb:161
  def initialize(response = T.unsafe(nil)); end
end

# Raised when the referenced page no longer exists.
#
# pkg:gem/ferrum#lib/ferrum/errors.rb:7
class Ferrum::NoSuchPageError < ::Ferrum::Error; end

# Raised when the referenced browser target cannot be found.
#
# pkg:gem/ferrum#lib/ferrum/errors.rb:9
class Ferrum::NoSuchTargetError < ::Ferrum::Error; end

# Represents a DOM node (an element or a text node) found on a {Page} or
# within a {Frame}. Provides methods to inspect it (`text`, `property`,
# `attribute`), interact with it (`click`, `focus`, `type`, `select`) and
# search within it (`at_css`, `at_xpath`, `css`, `xpath`).
#
# @note Node identity is tied to the target it was found on; a `Node`
#   fetched before a navigation cannot be used afterwards.
#
# pkg:gem/ferrum#lib/ferrum/node.rb:13
class Ferrum::Node
  # pkg:gem/ferrum#lib/ferrum/node.rb:19
  def initialize(frame, target_id, description, object_id: T.unsafe(nil), node_id: T.unsafe(nil)); end

  # Two nodes are equal when they belong to the same target and share the
  # same backend node id.
  #
  # @param [Object] other
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:442
  def ==(other); end

  # pkg:gem/ferrum#lib/ferrum/node.rb:340
  def [](name); end

  # Finds a node by CSS selector, scoped to search within this node. Runs
  # `querySelector` within this node.
  #
  # @param [String] selector
  #
  # @return [Node, nil]
  #
  # @example
  #   page.at_css("form").at_css("input[name='q']") # => Node
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:266
  def at_css(selector); end

  # Finds a node by xpath, scoped to search within this node. Runs
  # `document.evaluate` within this node.
  #
  # @param [String] selector
  #
  # @return [Node, nil]
  #
  # @example
  #   page.at_xpath("//iframe").at_xpath(".//a") # => Node
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:251
  def at_xpath(selector); end

  # Returns the value of the given HTML attribute, i.e.
  # `getAttribute(name)`. Unlike {#property}, it reads the attribute as
  # defined in markup rather than the live DOM property.
  #
  # @param [String] name
  #
  # @return [String, nil]
  #
  # @example
  #   page.at_css("input").attribute("value") # => "Foo"
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:354
  def attribute(name); end

  # Returns the computed accessibility node for the element, or nil if the
  # element is ignored by the accessibility tree.
  #
  # @return [Accessibility::AXNode, nil]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:496
  def axnode; end

  # Removes focus from the node.
  #
  # @return [self]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:137
  def blur; end

  # mode: (:left | :right | :double)
  # keys: (:alt, (:ctrl | :control), (:meta | :command), :shift)
  # offset: { :x, :y, :position (:top | :center) }
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:160
  def click(mode: T.unsafe(nil), keys: T.unsafe(nil), offset: T.unsafe(nil), delay: T.unsafe(nil)); end

  # Returns a hash of the computed styles for the node
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:486
  def computed_style; end

  # Finds nodes by CSS selector, scoped to search within this node. Runs
  # `querySelectorAll` within this node.
  #
  # @param [String] selector
  #
  # @return [Array<Node>]
  #
  # @example
  #   page.at_css("ul").css("li") # => [Node]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:296
  def css(selector); end

  # pkg:gem/ferrum#lib/ferrum/node.rb:17
  def description; end

  # Evaluates the given JavaScript expression with `this` bound to the
  # node.
  #
  # @param [String] expression
  #
  # @return [Object]
  #
  # @example
  #   page.at_css("input").evaluate("this.value")
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:430
  def evaluate(expression); end

  # Whether the node still exists in the DOM.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:515
  def exists?; end

  # Finds the x, y coordinates to click or hover on the node.
  #
  # @param [Integer, nil] x
  #   Horizontal offset from the reference point.
  #
  # @param [Integer, nil] y
  #   Vertical offset from the reference point.
  #
  # @param [Symbol] position
  #   `:top` to offset from the node's top-left corner, `:center` to offset
  #   from its center.
  #
  # @return [(Integer, Integer)]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:475
  def find_position(x: T.unsafe(nil), y: T.unsafe(nil), position: T.unsafe(nil)); end

  # Focuses the node.
  #
  # @return [self]
  #
  # @example
  #   input = page.at_css("input[name='q']")
  #   input.focus
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:82
  def focus; end

  # Whether the node can receive focus. Attempts to {#focus} the node to
  # find out.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:90
  def focusable?; end

  # The {Frame} this node belongs to. Keep using finder methods (`at_css`,
  # `at_xpath`, etc.) on it to search within that frame, e.g. inside an
  # `iframe`.
  #
  # @return [Frame, nil]
  #
  # @example
  #   frame = page.at_xpath("//iframe").frame # => Frame
  #   frame.at_css("//a[text() = 'Log in']") # => Node
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:69
  def frame; end

  # The id of the frame this node belongs to.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:54
  def frame_id; end

  # Not currently implemented.
  #
  # @raise [NotImplementedError] always
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:181
  def hover; end

  # Whether the node's bounding rect is fully within the viewport (or,
  # when `of:` is given, within that scoping element's bounds).
  #
  # @param [Node, nil] of
  #   An element to use as the visible bounds instead of the window.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:204
  def in_viewport?(of: T.unsafe(nil)); end

  # FIXME: clear API for text and inner_text
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:313
  def inner_text; end

  # A developer-friendly string representation of the node.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:456
  def inspect; end

  # Checks whether the node's position has stopped changing, by comparing
  # two content-quad snapshots taken `delay` seconds apart.
  #
  # @param [Float] delay
  #   Seconds to wait between the two position checks.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:127
  def moving?(delay: T.unsafe(nil)); end

  # Whether this is an element node, as opposed to e.g. a text node.
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:45
  def node?; end

  # Frontend node id is resolved lazily, on first actual need (focus, click, scroll_into_view, etc.)
  # We can try to subscribe to `DOM.childNodeRemoved` and `DOM.childNodeInserted` in the future
  # to keep track of nodes.
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:31
  def node_id; end

  # pkg:gem/ferrum#lib/ferrum/node.rb:17
  def page; end

  # Returns the given JavaScript property of the node.
  #
  # @param [String] name
  #
  # @return [Object]
  #
  # @example
  #   page.at_css("input").property("value") # => "Foo"
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:337
  def property(name); end

  # Removes the node from the DOM.
  #
  # @return [Hash{String => Object}]
  #
  # @example
  #   page.at_css("#ad").remove
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:508
  def remove; end

  # Scrolls the node into view if it is not already visible.
  #
  # @return [self]
  #
  # @example
  #   page.at_css("#footer").scroll_into_view
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:193
  def scroll_into_view; end

  # (chainable) Selects options of a `select` element by the given
  # attribute.
  #
  # @param [Array<String>] values
  #   The value(s) to select. Accepts a string, multiple strings, or an
  #   array of strings.
  #
  # @param [Symbol] by
  #   The `option` attribute to match `values` against, e.g. `:value` or
  #   `:text`.
  #
  # @return [self]
  #
  # @example
  #   page.at_xpath("//*[select]").select(["1"]) # => Node (select)
  #   page.at_xpath("//*[select]").select(["text"], by: :text) # => Node (select)
  #
  # @example Accepts a string, multiple strings or an array of strings:
  #   page.at_xpath("//*[select]").select("1")
  #   page.at_xpath("//*[select]").select("1", "2")
  #   page.at_xpath("//*[select]").select(["1", "2"])
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:398
  def select(*values, by: T.unsafe(nil)); end

  # Sets files on a file input node.
  #
  # @param [String, Array<String>] value
  #   Path or paths to the file(s) to upload.
  #
  # @return [Hash{String => Object}]
  #
  # @example
  #   page.at_css("input[type=file]").select_file("/path/to/file.png")
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:231
  def select_file(value); end

  # Returns the selected `option` nodes of a `select` element.
  #
  # @return [Array<Node>]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:363
  def selected; end

  # pkg:gem/ferrum#lib/ferrum/node.rb:17
  def tag_name; end

  # pkg:gem/ferrum#lib/ferrum/node.rb:17
  def target_id; end

  # The node's text content, i.e. `textContent`.
  #
  # @return [String]
  #
  # @example
  #   page.at_css("a > h3").text # => "rubycdp/ferrum: Ruby Chrome/Chromium driver - GitHub"
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:308
  def text; end

  # Sends keystrokes to the currently focused element via the page's
  # keyboard. Typically chained after {#focus} or `click`.
  #
  # @param [Array<String, Symbol, (Symbol, String)>] keys
  #   The keys to type, e.g. `"Input"`, `[:Shift, "s"], "tring"`.
  #
  # @return [self]
  #
  # @example
  #   input.focus.type("Input")
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:153
  def type(*keys); end

  # The node's `value` property. Useful for form elements such as `input`,
  # `select` and `textarea`.
  #
  # @return [Object]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:323
  def value; end

  # Waits until the node's position stops changing, retrying up to
  # `attempts` times. Raises {NodeMovingError} if the node is still moving
  # after the last attempt.
  #
  # @param [Float] delay
  #   Seconds to wait between two position checks.
  #
  # @param [Integer] attempts
  #   Maximum number of attempts before raising.
  #
  # @return [Array]
  #   The content quads of the node once it has stopped moving.
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:111
  def wait_for_stop_moving(delay: T.unsafe(nil), attempts: T.unsafe(nil)); end

  # Finds nodes by xpath, scoped to search within this node. Runs
  # `document.evaluate` within this node.
  #
  # @param [String] selector
  #
  # @return [Array<Node>]
  #
  # @example
  #   page.at_css("ul").xpath(".//li") # => [Node]
  #
  # pkg:gem/ferrum#lib/ferrum/node.rb:281
  def xpath(selector); end

  private

  # pkg:gem/ferrum#lib/ferrum/node.rb:524
  def bounding_rect_coordinates; end

  # pkg:gem/ferrum#lib/ferrum/node.rb:531
  def content_quads; end

  # pkg:gem/ferrum#lib/ferrum/node.rb:538
  def content_quads_with(delay: T.unsafe(nil)); end

  # pkg:gem/ferrum#lib/ferrum/node.rb:545
  def get_position(points, offset_x, offset_y, position); end

  # pkg:gem/ferrum#lib/ferrum/node.rb:570
  def to_points(quad); end
end

# pkg:gem/ferrum#lib/ferrum/node.rb:15
Ferrum::Node::MOVING_WAIT_ATTEMPTS = T.let(T.unsafe(nil), Integer)

# pkg:gem/ferrum#lib/ferrum/node.rb:14
Ferrum::Node::MOVING_WAIT_DELAY = T.let(T.unsafe(nil), Float)

# Raised when a node keeps moving between attempts to interact with it,
# e.g. while trying to click it.
#
# pkg:gem/ferrum#lib/ferrum/errors.rb:90
class Ferrum::NodeMovingError < ::Ferrum::Error
  # pkg:gem/ferrum#lib/ferrum/errors.rb:91
  def initialize(node, prev, current); end

  # Explains that the node moved between attempts to interact with it.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/errors.rb:103
  def message; end
end

# Raised when the browser reports that a DOM node no longer exists.
#
# pkg:gem/ferrum#lib/ferrum/errors.rb:156
class Ferrum::NodeNotFoundError < ::Ferrum::BrowserError; end

# Raised when a requested feature isn't implemented for the current setup.
#
# pkg:gem/ferrum#lib/ferrum/errors.rb:11
class Ferrum::NotImplementedError < ::Ferrum::Error; end

# Represents a single browser tab (a CDP target of type `page`). Owns the
# tab's {Mouse}, {Keyboard}, {Network}, {Cookies}, {Headers}, {Downloads}
# and {Accessibility} helpers, as well as its frame tree (see the included
# {Page::Frames} module), and is the object that navigation, DOM search and
# JavaScript evaluation methods are ultimately delegated to from {Browser}.
#
# pkg:gem/ferrum#lib/ferrum/page/frames.rb:6
class Ferrum::Page
  include ::Ferrum::Page::Animation
  include ::Ferrum::Page::Screencast
  include ::Ferrum::Page::Screenshot
  include ::Ferrum::Page::Frames
  include ::Ferrum::Page::Stream
  include ::Ferrum::Interceptable
  extend ::Forwardable

  # pkg:gem/ferrum#lib/ferrum/page.rb:90
  def initialize(client, context_id:, target_id:, proxy: T.unsafe(nil)); end

  # Accessibility object.
  #
  # @return [Accessibility]
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:73
  def accessibility; end

  # Activates (focuses) the target for the given page.
  # When you have multiple tabs you work with, and you need to switch a given one.
  #
  # @return [Boolean]
  #
  # @example
  #   page.activate # => true
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:409
  def activate; end

  # pkg:gem/ferrum#lib/ferrum/page.rb:34
  def add_script_tag(*, **, &); end

  # pkg:gem/ferrum#lib/ferrum/page.rb:34
  def add_style_tag(*, **, &); end

  # pkg:gem/ferrum#lib/ferrum/page.rb:34
  def at_css(*, **, &); end

  # pkg:gem/ferrum#lib/ferrum/page.rb:34
  def at_xpath(*, **, &); end

  # Navigates to the previous URL in the history.
  #
  # @example
  #   page.go_to("https://github.com/")
  #   page.at_xpath("//a").click
  #   page.back
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:349
  def back; end

  # pkg:gem/ferrum#lib/ferrum/page.rb:38
  def base_url(*, **, &); end

  # pkg:gem/ferrum#lib/ferrum/page.rb:34
  def body(*, **, &); end

  # Enables/disables CSP bypass.
  #
  # @param [Boolean] enabled
  #
  # @return [Boolean]
  #
  # @example
  #   page.bypass_csp # => true
  #   page.go_to("https://github.com/ruby-concurrency/concurrent-ruby/blob/master/docs-source/promises.in.md")
  #   page.refresh
  #   page.add_script_tag(content: "window.__injected = 42")
  #   page.evaluate("window.__injected") # => 42
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:395
  def bypass_csp(enabled: T.unsafe(nil)); end

  # Client connection.
  #
  # @return [Client]
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:53
  def client; end

  # Closes the page's target and its underlying client connection.
  #
  # @return [Boolean]
  #
  # @example
  #   page.close # => true
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:151
  def close; end

  # Closes the underlying client connection only, without closing the
  # target itself. Useful when you want to detach from a page without
  # ending the browser tab it represents.
  #
  # pkg:gem/ferrum#lib/ferrum/page.rb:164
  def close_connection; end

  # Sends a CDP command to the browser and optionally waits for network
  # activity on the main frame to settle before returning.
  #
  # @param [String] method
  #   The CDP method name, e.g. `"Page.navigate"`.
  #
  # @param [Numeric] wait
  #   How many seconds to wait for a network event on the main frame after
  #   the command is sent. `0` disables waiting.
  #
  # @param [Boolean] slowmoable
  #   Whether to sleep for `Browser::Options#slowmo` seconds before sending
  #   the command.
  #
