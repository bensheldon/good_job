  def editing_command(pressed, char); end

  # pkg:gem/ferrum#lib/ferrum/keyboard.rb:104
  def normalize_keys(keys, pressed_keys = T.unsafe(nil), memo = T.unsafe(nil)); end

  # pkg:gem/ferrum#lib/ferrum/keyboard.rb:170
  def to_options(hash); end
end

