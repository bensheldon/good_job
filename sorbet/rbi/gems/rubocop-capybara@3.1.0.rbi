  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/rspec/current_url_expectation.rb:40
  def url_actual(param0 = T.unsafe(nil)); end

  private

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/rspec/current_url_expectation.rb:106
  def autocorrect(corrector, actual, runner, matcher, regexp); end

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/rspec/current_url_expectation.rb:90
