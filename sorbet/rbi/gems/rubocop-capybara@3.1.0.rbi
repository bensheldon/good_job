# Checks for boolean values passed to Capybara's `visible` option.
#
# `visible: false` finds both visible and hidden elements, rather than
# only hidden elements. Use `:all`, `:hidden` or `:visible` instead.
# Only `true` is autocorrected, to `:visible`.
#
# This cop targets Capybara's built-in selectors. Set `DefaultSelector`
# to match `Capybara.default_selector`, or to `null` if it varies at
# runtime. Queries using custom or unknown selectors are skipped.
#
# @example
#   # bad
#   find('.menu', visible: true)
#   expect(page).to have_css('.menu', visible: false)
#
#   # good
#   find('.menu', visible: :visible)
#   find('.menu', visible: :all)
#   find('.menu', visible: :hidden)
#
# @example DefaultSelector: custom
#   # bad
#   find(:css, '.menu', visible: true)
#
#   # good
#   find('.menu', visible: true)
#
# pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/visibility_option.rb:33
class RuboCop::Cop::Capybara::VisibilityOption < ::RuboCop::Cop::Base
  include ::RuboCop::Cop::Capybara::CapybaraHelp
  include ::RuboCop::Cop::Capybara::Visibility
  extend ::RuboCop::Cop::AutoCorrector

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/visibility_option.rb:48
  def boolean_visibility?(param0 = T.unsafe(nil)); end

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/visibility_option.rb:60
  def on_csend(node); end

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/visibility_option.rb:52
  def on_send(node); end

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/visibility_option.rb:43
  def visibility_options(param0 = T.unsafe(nil)); end
end

# pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/visibility_option.rb:38
RuboCop::Cop::Capybara::VisibilityOption::RESTRICT_ON_SEND = T.let(T.unsafe(nil), Array)
