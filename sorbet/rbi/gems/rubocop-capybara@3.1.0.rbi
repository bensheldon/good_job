  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/rspec/current_path_expectation.rb:103
  def regexp_node_to_regexp_expr(regexp_node); end

  # pkg:gem/rubocop-capybara#lib/rubocop/cop/capybara/rspec/current_path_expectation.rb:90
  def rewrite_expectation(corrector, node, to_symbol, matcher_node); end

  class << self
