Protocol::HTTP2::GoawayFrame::FORMAT = T.let(T.unsafe(nil), String)

# pkg:gem/protocol-http2#lib/protocol/http2/goaway_frame.rb:21
Protocol::HTTP2::GoawayFrame::TYPE = T.let(T.unsafe(nil), Integer)

