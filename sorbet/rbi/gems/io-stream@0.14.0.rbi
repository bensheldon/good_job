end

# StringIO extensions for buffering support.
#
# pkg:gem/io-stream#lib/io/stream/shim/buffered.rb:68
class StringIO
  include ::Enumerable

  # Set the buffered state of the StringIO.
  # @parameter value [Boolean] True to enable buffering, false to disable.
  #
  # pkg:gem/io-stream#lib/io/stream/shim/buffered.rb:77
  def buffered=(value); end

  # Check if the StringIO is buffered.
  # @returns [Boolean] True if the StringIO is buffered (not synchronized).
  #
  # pkg:gem/io-stream#lib/io/stream/shim/buffered.rb:71
  def buffered?; end

  # Check if the StringIO is readable.
  # @returns [Boolean] True if the StringIO is readable (not at EOF).
  #
  # pkg:gem/io-stream#lib/io/stream/shim/readable.rb:45
  def readable?; end

  # Return the configured timeout for this in-memory stream.
  # @returns [Numeric | Nil] The configured timeout, if any.
  #
  # pkg:gem/io-stream#lib/io/stream/shim/timeout.rb:12
  def timeout; end

  # Store timeout state for compatibility with IO-like timeout interfaces.
  # @parameter duration [Numeric | Nil] The timeout to assign.
  # @returns [Numeric | Nil] The assigned timeout.
  #
  # pkg:gem/io-stream#lib/io/stream/shim/timeout.rb:21
  def timeout=(duration); end
end
