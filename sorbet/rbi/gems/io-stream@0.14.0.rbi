  # pkg:gem/io-stream#lib/io/stream/string_buffer.rb:21
  def <<(string); end

  # pkg:gem/io-stream#lib/io/stream/string_buffer.rb:31
  def concat(string); end
end

# pkg:gem/io-stream#lib/io/stream/string_buffer.rb:9
IO::Stream::StringBuffer::BINARY = T.let(T.unsafe(nil), Encoding)

# pkg:gem/io-stream#lib/io/stream/version.rb:7
IO::Stream::VERSION = T.let(T.unsafe(nil), String)

# A module providing writable stream functionality.
#
# You must implement the `syswrite` method to write data to the underlying IO.
#
# pkg:gem/io-stream#lib/io/stream/writable.rb:15
module IO::Stream::Writable
  # Initialize writable stream functionality.
  # @parameter minimum_write_size [Integer] The minimum buffer size before flushing.
  #
  # pkg:gem/io-stream#lib/io/stream/writable.rb:32
  def initialize(minimum_write_size: T.unsafe(nil), **, &block); end

  # Appends `string` to the buffer and returns self for method chaining.
  # @parameter string [String] the string to write to the stream.
  #
  # pkg:gem/io-stream#lib/io/stream/writable.rb:71
  def <<(string); end

  # Close the write end of the stream by flushing any remaining data.
  #
  # pkg:gem/io-stream#lib/io/stream/writable.rb:93
  def close_write; end

  # Flushes buffered data to the stream.
  #
  # pkg:gem/io-stream#lib/io/stream/writable.rb:43
  def flush; end

  # pkg:gem/io-stream#lib/io/stream/writable.rb:40
  def minimum_write_size; end

  # pkg:gem/io-stream#lib/io/stream/writable.rb:40
  def minimum_write_size=(_arg0); end

  # Write arguments to the stream followed by a separator and flush immediately.
  # @parameter arguments [Array] The arguments to write to the stream.
  # @parameter separator [String] The separator to append after each argument.
  #
  # pkg:gem/io-stream#lib/io/stream/writable.rb:80
  def puts(*arguments, separator: T.unsafe(nil)); end

  # Writes `string` to the buffer. When the buffer is full or #sync is true the
  # buffer is flushed to the underlying `io`.
  # @parameter string [String] the string to write to the buffer.
  # @returns [Integer] the number of bytes appended to the buffer.
  #
  # pkg:gem/io-stream#lib/io/stream/writable.rb:55
  def write(string, flush: T.unsafe(nil)); end

  private

  # pkg:gem/io-stream#lib/io/stream/writable.rb:97
  def drain(buffer); end

  class << self
    # Check if a method is async-safe.
    #
    # @parameter method [Symbol] The method name to check.
    # @returns [Symbol | Boolean] The concurrency guard for the given method.
    #
    # pkg:gem/io-stream#lib/io/stream/writable.rb:26
    def async_safe?(method); end
  end
end

# pkg:gem/io-stream#lib/io/stream/writable.rb:16
IO::Stream::Writable::ASYNC_SAFE = T.let(T.unsafe(nil), Hash)

IO::WRITABLE = T.let(T.unsafe(nil), Integer)

# SSL socket extensions for stream compatibility.
