# pkg:gem/io-stream#lib/io/stream/shim/readable.rb:53
class OpenSSL::SSL::SSLSocket
  include ::Enumerable

  # Set the buffered state of the SSL socket.
  # @parameter value [Boolean] True to enable buffering, false to disable.
  #
