  # │                        └───┬────┘
  # │                            │
  # │                            │ send request /
  # │                            │ receive request
  # │                            │
  # │                            ▼
  # │                        ┌────────┐
  # │                recv ES │        │ send ES
  # │           ┌────────────┤  open  ├────────────┐
  # │           │            │        │            │
  # │           ▼            └───┬────┘            ▼
  # │      ┌──────────┐          │           ┌──────────┐
  # │      │   half   │          │           │   half   │
  # │      │  closed  │          │ send R /  │  closed  │
  # │      │ (remote) │          │ recv R    │ (local)  │
  # │      └────┬─────┘          │           └─────┬────┘
  # │           │                │                 │
  # │           │ send ES /      │       recv ES / │
  # │           │ close          ▼           close │
  # │           │            ┌────────┐            │
  # │           └───────────►│        │◄───────────┘
  # │                        │ closed │
  # └────────────────────────┤        │
  #         persistent       └────────┘
