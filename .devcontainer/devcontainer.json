// Update the VARIANT arg in docker-compose.yml to pick a Ruby version
{
	"name": "Ruby on Rails & Postgres",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	// Features to add to the dev container. More info: https://containers.dev/implementors/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// This can be used to network with other containers or the host.
	"forwardPorts": [3000, 5432, 8808],
	"portsAttributes": {
		"3000": { "label": "Demo app", "protocol": "http" },
		"5432": { "label": "Postgres", "protocol": "tcp" },
		"8808": { "label": "YARD docs", "protocol": "http" }
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bin/setup",

	// The base image's user; Postgres has a matching role (create-db-user.sql).
	"remoteUser": "vscode",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": ["task.vscode-task"]
		},
		"taste-ide": {
			"services": {
				"server": { "port": 3000 },
				"server:quiet": { "port": 3000 },
				"docs": { "port": 8808 }
			}
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
